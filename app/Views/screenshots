    <script>
        function isValidCameroonianNumber(number) {
            return number.length === 9; // Verify 9-digit number
        }

        function showTransferOptions() {
            const telNum = document.getElementById('tel_num').value;
            if (isValidCameroonianNumber(telNum)) {
                $('#phoneModal').modal('hide');
                $('#transferModal').modal('show');
            } else {
                alert('Please enter a valid 9-digit Cameroonian number.');
            }
        }

        function showSendMoneyModal() {
            const recipientNum = document.getElementById('recipient').value;
            if (isValidCameroonianNumber(recipientNum)) {
                $('#transferModal').modal('hide');
                $('#sendMoneyModal').modal('show');
            } else {
                alert('Please enter a valid 9-digit recipient number.');
            }
        }

        function showAmountModal() {
            $('#sendMoneyModal').modal('hide');
            $('#amountModal').modal('show');
        }

        function showPasswordModal() {
            const amount = document.getElementById('amount').value;
            if (amount >= 5000) {
                $('#amountModal').modal('hide');
                $('#passwordModal').modal('show');
            } else {
                alert('Amount must be at least 5000 FCFA.');
            }
        }

        function showSuccessModal() {
            $('#passwordModal').modal('hide');
            $('#successModal').modal('show');
        }

        function showAnnulledModal() {
            $('#transferModal').modal('hide');
            $('#annulledModal').modal('show');
        }
    </script>
</body>

